# Copy to `.env` for local development (loaded via python-dotenv / your shell).
# All values are optional; the app falls back to the free HuggingFace stack.

# Free HuggingFace token for the hosted LLM (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Optional OpenAI key (only if using the OpenAI backend)
OPENAI_API_KEY=

# Backend selection: "huggingface" (default, free) or "openai"
EMBEDDING_BACKEND=huggingface
LLM_BACKEND=huggingface

# Model overrides (defaults shown)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chunking / retrieval (empirically tuned - see docs/EXPERIMENTS.md)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
TEMPERATURE=0.0
