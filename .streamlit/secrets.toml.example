# Copy this file to `.streamlit/secrets.toml` for local runs, or paste its
# contents into the "Secrets" box in the Streamlit Community Cloud dashboard.
# NEVER commit the real secrets.toml (it is git-ignored).

# Free HuggingFace token - powers the default (free) hosted LLM.
# Create one at https://huggingface.co/settings/tokens (role: "Read").
# This is the ONLY secret the free demo needs. Recruiters need nothing.
HF_TOKEN = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional - only if you want to offer / default to the OpenAI backend.
# OPENAI_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional overrides (defaults shown):
# EMBEDDING_BACKEND = "huggingface"   # or "openai"
# LLM_BACKEND       = "huggingface"   # or "openai"
# HF_CHAT_MODEL     = "Qwen/Qwen2.5-7B-Instruct"
